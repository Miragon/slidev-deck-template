{
  "name": "@miragon/slidev-deck",
  "type": "module",
  "private": true,
  "description": "Reference deck that consumes @miragon/slidev-toolkit. This is the template body: cover, chapters and closing.",
  "scripts": {
    "dev": "portless",
    "dev:app": "slidev slides.md --port ${PORT:-3030} --remote --bind 127.0.0.1",
    "build": "slidev build slides.md --out ../dist",
    "export": "slidev export slides.md"
  },
  "dependencies": {
    "@slidev/cli": "52.18.0",
    "slidev-addon-bpmn": "1.10.0",
    "slidev-addon-dmn": "1.3.0",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "portless": "0.15.4"
  }
}
