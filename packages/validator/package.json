{
  "name": "@miragon/slidev-validator",
  "version": "0.2.0",
  "type": "module",
  "description": "The Miragon Slidev deck validator: a configurable design-system linter (stable rule IDs, off/warn/error severities, extends/overrides/exceptions) shipped as a versioned CLI so central guardrail improvements reach decks over npm instead of a frozen copy.",
  "keywords": [
    "slidev",
    "miragon",
    "validator",
    "linter",
    "design-system"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/slidev-deck-template.git",
    "directory": "packages/validator"
  },
  "homepage": "https://github.com/Miragon/slidev-deck-template/tree/main/packages/validator#readme",
  "bugs": "https://github.com/Miragon/slidev-deck-template/issues",
  "bin": {
    "slidev-validator": "bin/index.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./recommended": "./src/presets/recommended.mjs",
    "./required": "./src/presets/required.mjs"
  },
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@slidev/parser": "52.18.0",
    "playwright-chromium": "1.62.1"
  },
  "peerDependencies": {
    "@miragon/slidev-toolkit": ">=1.15.0 <2"
  },
  "files": [
    "bin",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
