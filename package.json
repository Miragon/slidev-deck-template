{
  "name": "miragon-slidev-deck",
  "type": "module",
  "private": true,
  "workspaces": [
    "kits/*/packages/*",
    "kits/slidev/deck",
    "kits/docs/example"
  ],
  "scripts": {
    "dev": "npm run dev -w kits/slidev/deck",
    "dev:plain": "npm run dev:app -w kits/slidev/deck",
    "build": "npm run build -w kits/slidev/deck",
    "export": "npm run export -w kits/slidev/deck",
    "check:ids": "slide-ids --check --entry kits/slidev/deck/slides.md",
    "stamp:ids": "slide-ids --stamp --entry kits/slidev/deck/slides.md",
    "preverify": "npm run check:ids",
    "verify": "cd kits/slidev && SLIDEV_PROFILE=none slidev-validator --rendered",
    "preverify:ci": "npm run check:ids",
    "verify:ci": "cd kits/slidev && SLIDEV_PROFILE=none slidev-validator --rendered",
    "preverify:source": "npm run check:ids",
    "verify:source": "cd kits/slidev && SLIDEV_PROFILE=none slidev-validator",
    "shot": "node kits/slidev/scripts/shot.mjs",
    "check:release": "node shared/scripts/check-release-config.mjs"
  },
  "overrides": {
    "magic-string@1.4.3": "1.4.2",
    "vitepress": {
      "vite": "6.4.5"
    },
    "vitepress-plugin-mermaid": {
      "mermaid": "12.3.0"
    }
  }
}
