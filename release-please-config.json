{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "plugins": [
    "node-workspace"
  ],
  "packages": {
    "packages/toolkit": {
      "package-name": "@miragon/slidev-toolkit",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false
    },
    "packages/create-deck": {
      "package-name": "@miragon/create-slidev-deck",
      "component": "create-slidev-deck",
      "include-component-in-tag": true
    },
    "packages/validator": {
      "package-name": "@miragon/slidev-validator",
      "component": "slidev-validator",
      "include-component-in-tag": true
    },
    "miragon-slidev-plugin": {
      "release-type": "simple",
      "package-name": "miragon-slidev-plugin",
      "component": "miragon-slidev-plugin",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
